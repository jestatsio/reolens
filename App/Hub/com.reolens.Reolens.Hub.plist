<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Reolens Hub LaunchAgent (0.7.0).

      Registered by App/Hub/HubController.swift via
      `SMAppService.agent(plistName: "com.reolens.Reolens.Hub.plist")`
      when the user enables "Run this Mac as a Reolens Hub". It must be
      bundled at Contents/Library/LaunchAgents/ inside the signed .app
      (see Scripts/build-app.sh) — that is where SMAppService looks for
      an agent plist.

      It relaunches THIS SAME signed binary in headless Hub mode
      (`--hub`), which AppDelegate detects to set an accessory
      activation policy (no Dock icon, no window) and start HubEngine.
      Running the same binary — rather than a separate helper — means
      the Hub inherits the app's Keychain access and iCloud/CloudKit
      entitlements with no extra plumbing (AGENTS.md §4/§5).

      RunAtLoad + KeepAlive give two recovery layers on top of
      CameraSession's own reconnect backoff: launchd restarts the
      process if it crashes, and HubEngine's sweep reconnects dropped
      camera sessions.

      AssociatedBundleIdentifiers surfaces the agent under "Reolens" in
      System Settings → General → Login Items, so it is discoverable and
      user-removable — never a silent install (AGENTS.md §5).
    -->
    <key>Label</key>
    <string>com.reolens.Reolens.Hub</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/Reolens</string>
    <key>ProgramArguments</key>
    <array>
        <string>Contents/MacOS/Reolens</string>
        <string>--hub</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.reolens.Reolens</string>
    </array>
</dict>
</plist>
